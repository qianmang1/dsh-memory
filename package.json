{
  "name": "dsh-memory",
  "version": "0.3.0",
  "description": "DeepSeek Harness 长期记忆插件：TS 直连自托管 mem0，提供记忆工具、SessionStart 自动召回、Stop 候审队列与侧边栏待审页。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core-plugin.js",
    "./recall": "./lib/recall.js",
    "./capture": "./lib/capture.js",
    "./review": "./lib/review.js",
    "./debug": "./lib/debug-plugin.js",
    "./core/locale/*.json": "./locale/core/*.json",
    "./recall/locale/*.json": "./locale/recall/*.json",
    "./capture/locale/*.json": "./locale/capture/*.json",
    "./review/locale/*.json": "./locale/review/*.json",
    "./debug/locale/*.json": "./locale/debug/*.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "skill",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qianmang1/dsh-memory.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev:client": "tsdown --watch --config tsdown.client.config.ts",
    "prepack": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --import ./scripts/test-module-map.mjs --test \"tests/**/*.test.ts\""
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "deepseek-harness",
    "memory",
    "mem0",
    "agent"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-util-code-language": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-time": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@shikijs/langs": "^4.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dsh-better-sidebar": "^0.24.1",
    "katex": "^0.19.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.5.0",
    "simple-icons": "^16.34.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0"
  }
}
